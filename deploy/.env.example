# Copy to deploy/.env; set a fresh random secret (at least 32 characters).
EMS_SECRET_KEY=
# For a local TLS check use localhost. Hosting requires a real DNS name.
EMS_SITE_ADDRESS=localhost
EMS_PUBLIC_HOST=localhost
EMS_ALLOWED_HOSTS=localhost
EMS_CSRF_TRUSTED_ORIGINS=https://localhost
EMS_HTTP_PORT=80
EMS_HTTPS_PORT=443
