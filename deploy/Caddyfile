{$EMS_SITE_ADDRESS} {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    handle /api/* {
        reverse_proxy gateway:3000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
