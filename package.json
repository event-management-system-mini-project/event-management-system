{
  "name": "event-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:gateway": "node gateway/server.mjs",
    "dev:frontend": "vite --config frontend/vite.config.mjs",
    "build": "vite build --config frontend/vite.config.mjs",
    "test:gateway": "node --test gateway/server.test.mjs",
    "test:backend": "node scripts/python.mjs backend/manage.py test events.tests --verbosity 2",
    "test:organizer": "node scripts/python.mjs backend/manage.py test modules.organizer --verbosity 2",
    "test:frontend": "vitest run --config frontend/vitest.config.mjs",
    "check": "node scripts/python.mjs backend/manage.py check",
    "test": "npm run test:backend && npm run test:organizer && npm run test:gateway && npm run test:frontend",
    "smoke": "node scripts/python.mjs scripts/smoke.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^29.1.1",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
